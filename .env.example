# ==============================================================================
# Progressive Credential Loading (PCL) Configuration
# Repository: webhook-delivery-system
# ==============================================================================
#
# TIER 1: ZERO-SETUP / LOCAL DEV / CI (Default)
# - In-memory retry queue and mock webhook receiver.
#
# TIER 2 / TIER 3: PRODUCTION REDIS/POSTGRES WITH EXPONENTIAL BACKOFF
# - Connect to Redis for durable BullMQ / celery queues.

DATABASE_URL=postgresql://user:pass@localhost:5432/webhooks_db
REDIS_URL=redis://localhost:6379
WEBHOOK_SECRET=dev-secret-sign-payloads
PORT=3000
